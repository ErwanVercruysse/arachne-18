	(text "ARACHNE-18 BRAIN v1.0 - Raspberry Pi CM5 + ESP32-S3 + MPU-6050 hexapod controller (generated by tools/build_sch.py from tools/design.py)"
		(exclude_from_sim no)
		(at 15 552 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4265b65b-36b6-5e59-8b5e-d1180ef01965")
	)
	(text "Servo connectors: 1 = GND, 2 = +12 V, 3 = DATA (Feetech STS half-duplex bus, 1 Mbaud). CHECK the pin order against your cable before plugging in!"
		(exclude_from_sim no)
		(at 15 556 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2d278f64-c834-5620-b1a1-53fa3d65a190")
	)
	(text "Bus A = legs L1 L2 L3 (ESP32 UART1: TX IO17, RX IO18, DE IO16).  Bus B = legs L4 L5 L6 (UART2: TX IO10, RX IO11, DE IO9). DE = RTS in RS485 half-duplex mode."
		(exclude_from_sim no)
		(at 15 560 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c993f658-81ac-59ec-bbdc-58ddc03a5dd6")
	)
	(text "CM5 is never back-powered: ESP->CM5 UART through 74LVC1G34 powered by CM5_3V3, ESP reset/boot via 2N7002, USB switch disabled while the CM5 is off."
		(exclude_from_sim no)
		(at 15 564 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f9c42408-a1fb-5419-8ea5-13da8e5c7e9f")
	)
	(text "ESP32 USB: USB-C plugged in -> ESP32 talks to the PC; otherwise it is wired to CM5 USB3-0 (USB2 pair) -> /dev/ttyACM* on the Pi."
		(exclude_from_sim no)
		(at 15 568 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4deeec0d-da7b-5ab7-8b5d-1fa89fe2fc44")
	)
	(text "PI LINK header = pins 1-10 of a Raspberry Pi 40-pin header: a straight 10-way ribbon connects an external Pi 4 (5 V, GND, UART, GPIO4 = ESP reset) when no CM5 is fitted."
		(exclude_from_sim no)
		(at 15 572 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5ca41208-10d9-5a9d-93b0-73386354f1d5")
	)
	(text "Buck = TI TPS54560B datasheet design (fig. 32): 400 kHz, 5.0 V 5 A. UVLO start 6.5 V."
		(exclude_from_sim no)
		(at 15 576 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d8c3f18e-5bb8-5cec-afa4-a3c370d943e8")
	)
